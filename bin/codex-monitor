#!/usr/bin/env python3
"""Compatibility wrapper: `codex-acct` is the same CLI as `codex-monitor`.
Works from a git checkout without installation."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from codex_monitor.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
